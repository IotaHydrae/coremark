# Build output, wherever a build was configured from.
build/
build-*/
rpi-pico/build*/
*.elf
*.uf2
*.bin
*.hex
*.map
*.dis

# Probe output: tools/probe.py defaults to ./probe-<board>-<stamp>, which is the
# directory the command was run from.  The whole point of that directory is that
# it is throwaway -- but it also holds a complete cmake build tree, so it must not
# be one `git add -A` away from being committed.
probe-*/

# Python bytecode, from importing the tool rather than running it.
__pycache__/
*.pyc

# The virtualenv the console reader's pyusb lives in -- the one thing probe.py
# needs that the system python does not have.  It is a local `python -m venv`
# artifact, thousands of files of it, and nothing the repository has a reason to
# carry: recreate it with `python3 -m venv .venv && .venv/bin/pip install pyusb`.
.venv/
